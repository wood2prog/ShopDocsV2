<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Per-user install: no admin/UAC prompt, installs to the current Windows
    user's %LocalAppData%\Programs\ShopDocsV2. Matches where the app already
    keeps its SQLite database and settings.json (see Infrastructure/Files
    provider and SchemaInitializer).

    UpgradeCode must never change across releases - it's what lets a newer
    MSI recognize and replace an older install of this product.
  -->
  <Package Name="ShopDocsV2"
           Manufacturer="ShopDocsV2"
           Version="1.0.13"
           UpgradeCode="60e15a1c-79fe-4b49-9d75-311903155792"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\..\src\ShopDocsV2.WinForms\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ShopDocsV2" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ShopDocsV2" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="e1263c5d-10b3-468a-9720-a5b13a63c4f9">
      <Shortcut Id="StartMenuShortcutFile"
                Name="ShopDocsV2"
                Description="Capture and export per-room job specs"
                Target="[INSTALLFOLDER]ShopDocsV2.WinForms.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="CleanUpStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ShopDocsV2" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="df9bd060-f4d3-4d26-8d0f-639299f6be92">
      <Shortcut Id="DesktopShortcutFile"
                Name="ShopDocsV2"
                Description="Capture and export per-room job specs"
                Target="[INSTALLFOLDER]ShopDocsV2.WinForms.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\ShopDocsV2" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="ShopDocsV2" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Package>
</Wix>
