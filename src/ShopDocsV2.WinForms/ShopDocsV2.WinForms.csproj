<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ShopDocsV2.Domain\ShopDocsV2.Domain.csproj" />
    <ProjectReference Include="..\ShopDocsV2.Application\ShopDocsV2.Application.csproj" />
    <ProjectReference Include="..\ShopDocsV2.Infrastructure\ShopDocsV2.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="questions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <!-- Keep in sync with Version in installer/ShopDocsV2.Installer/Package.wxs. -->
    <Version>1.0.19</Version>
    <Product>Shop Docs</Product>
    <Company>Jesse Ogburn</Company>
    <!-- Year is taken at compile time, so each build carries the current year. -->
    <Copyright>© $([System.DateTime]::Now.Year) Jesse Ogburn. Licensed under the MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile date shown in the About dialog; read back via AssemblyMetadataAttribute("BuildDate"). -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

</Project>