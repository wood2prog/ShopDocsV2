{
  "sections": [
    {
      "title": "Cabinets",
      "questions": [
        {
          "id": "cabinet_style",
          "label": "Cabinet Style",
          "type": "select",
          "options": ["Framed", "Frameless"],
          "default": "Framed"
        },
        { "id": "cabinet_door_style", "label": "Door Style", "type": "select", "options": ["Shaker", "Raised Panel"] },
        { "id": "cabinet_drawer_style", "label": "Drawer Front Style", "type": "select", "options": ["Slab", "Five Piece"] },
        { "id": "soft_close", "label": "Soft-close hinges/slides", "type": "checkbox" },
        {
          "id": "cabinet_finishes",
          "label": "Cabinet Finishes",
          "type": "list",
          "addLabel": "+ Add Cabinet Finish",
          "itemFields": [
            { "id": "name", "label": "Name", "placeholder": "e.g. Perimeter Upper, Perimeter Base, Island" },
            { "id": "wood", "label": "Wood", "type": "select", "catalogSource": "materials" },
            { "id": "finish", "label": "Finish", "type": "select", "catalogSource": "finishes", "colorPreview": true }
          ]
        },
        {
          "id": "cabinet_hardware",
          "label": "Hardware (pulls, knobs)",
          "type": "list",
          "addLabel": "+ Add Hardware",
          "itemFields": [
            { "id": "name", "label": "Name", "placeholder": "e.g. Pull, Knob" },
            { "id": "quantity", "label": "Qty", "type": "number", "placeholder": "Qty" },
            { "id": "catalogItem", "label": "Catalog Item", "type": "select", "catalogSource": "pulls" },
            { "id": "color", "label": "Color", "type": "select", "catalogSource": "hardware_colors" },
            { "id": "model", "label": "Model Number", "placeholder": "Model # (shop notes only)" }
          ]
        }
      ]
    },
    {
      "title": "Countertops",
      "questions": [
        {
          "id": "countertops",
          "label": "Countertops",
