            { "id": "faucet_style", "label": "Faucet Style", "type": "select", "options": ["Single Hole", "4\" Spread", "8\" Spread"] }
          ]
        }
      ]
    },
    {
      "title": "Appliances",
      "questions": [
        {
          "id": "appliance_package",
