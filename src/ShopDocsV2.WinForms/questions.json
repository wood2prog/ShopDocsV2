          "addLabel": "+ Add Countertop",
          "itemFields": [
            {
              "id": "material",
              "label": "Material",
              "type": "select",
              "options": ["Laminate", "Granite", "Quartz", "Butcher Block", "Solid Surface", "Tile", "Other"]
            },
            { "id": "color", "label": "Color / Pattern", "type": "select", "catalogSource": "countertops", "catalogFilterBy": "material" },
            {
              "id": "edge_profile",
              "label": "Edge Profile",
              "type": "select",
              "options": ["Eased", "1/4\" Round", "1/4\" Bevel", "Half Bevel", "Half Bullnose", "Full Bullnose", "Long Ogee", "Demi Bullnose"]
            },
            {
              "id": "backsplash",
              "label": "Backsplash",
              "type": "select",
              "options": ["4\" Backsplash", "No Backsplash", "Other - See Notes"]
            }
          ]
        }
      ]
    },
    {
      "title": "Sink & Faucet",
      "questions": [
        {
          "id": "sinks",
          "label": "Sinks",
