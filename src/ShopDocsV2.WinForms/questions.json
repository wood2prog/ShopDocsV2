            { "id": "cutout_height", "label": "Cutout H", "type": "dimension", "placeholder": "Height", "printGroup": "Cutout", "printSuffix": "H" },
            { "id": "cutout_depth", "label": "Cutout D", "type": "dimension", "placeholder": "Depth", "printGroup": "Cutout", "printSuffix": "D" }
